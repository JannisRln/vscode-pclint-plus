{
  "name": "vscode-pclint-plus",
  "displayName": "vscode-pclint-plus",
  "description": " Fast PC-lint Plus diagnostics for C/C++ projects",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:cuda-cpp",
    "onLanguage:pclint-lnt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pclintPlus.lintCurrentFile",
        "title": "PC-lint Plus: Lint Current File"
      },
      {
        "command": "pclintPlus.showOutput",
        "title": "PC-lint Plus: Show Output"
      },
      {
        "command": "pclintPlus.copyLastCommand",
        "title": "PC-lint Plus: Copy Last Command"
      },
      {
        "command": "pclintPlus.clearDiagnostics",
        "title": "PC-lint Plus: Clear Diagnostics"
      },
      {
        "command": "pclintPlus.rebuildPch",
        "title": "PC-lint Plus: Rebuild PCH"
      }
    ],
    "configuration": {
      "title": "PC-lint Plus",
      "properties": {
        "pclintPlus.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "pclintPlus.executable": {
          "type": "string",
          "default": "pclp",
          "scope": "resource"
        },
        "pclintPlus.ruleset": {
          "type": "string",
          "default": "${workspaceFolder}/lint/project.lnt",
          "scope": "resource"
        },
        "pclintPlus.diagnostics.messageXmlPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Full path to the PC-lint Plus message XML file, including the XML file name, for example ${workspaceFolder}/lint/msg.xml. When set, PC-lint Plus message text and commentary are shown in editor hovers for diagnostics while the Problems list remains compact."
        },
        "pclintPlus.triggers.onSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "pclintPlus.triggers.onType": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "pclintPlus.triggers.onTypeDelayMs": {
          "type": "number",
          "default": 2500,
          "minimum": 250,
          "scope": "resource"
        },
        "pclintPlus.analysis.useUnitCheck": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "pclintPlus.buildInfo.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Include directories passed to PC-lint Plus. Entries ending in **, such as ${workspaceFolder}/src/**, are expanded recursively to include all subdirectories."
        },
        "pclintPlus.buildInfo.defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource"
        },
        "pclintPlus.buildInfo.standard": {
          "type": "string",
          "default": "",
          "scope": "resource"
        },
        "pclintPlus.diagnostics.includeHeaders": {
          "type": "boolean",
          "default": false,
          "scope": "resource"
        },
        "pclintPlus.logging.showCommand": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "pclintPlus.logging.fullOutput": {
          "type": "boolean",
          "default": false,
          "scope": "resource"
        },
        "pclintPlus.activeProfile": {
          "type": "string",
          "default": "default",
          "scope": "resource",
          "description": "Active PC-lint Plus profile name."
        },
        "pclintPlus.profiles": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "Named PC-lint Plus profiles with ruleset, buildInfo, and pch settings."
        },
        "pclintPlus.buildInfo.systemIncludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "System include directories passed to PC-lint Plus. Entries ending in **, such as ${workspaceFolder}/external/**, are expanded recursively to include all subdirectories."
        },
        "pclintPlus.pch.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource"
        },
        "pclintPlus.pch.header": {
          "type": "string",
          "default": "",
          "scope": "resource"
        },
        "pclintPlus.pch.watch": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "pclintPlus.runner.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "scope": "resource"
        },
        "pclintPlus.diagnostics.severityMap": {
          "type": "object",
          "default": {
            "error": "error",
            "warning": "warning",
            "info": "information",
            "note": "hint"
          },
          "scope": "resource"
        },
        "pclintPlus.diagnostics.messageSeverityOverrides": {
          "type": "object",
          "default": {},
          "scope": "resource"
        }
      }
    },
    "languages": [
      {
        "id": "pclint-lnt",
        "aliases": [
          "PC-lint Plus LNT",
          "PC-lint LNT",
          "LNT"
        ],
        "extensions": [
          ".lnt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pclint-lnt",
        "scopeName": "source.pclint-lnt",
        "path": "./syntaxes/pclint-lnt.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  }
}
